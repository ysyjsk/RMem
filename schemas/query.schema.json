{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query",
  "type": "object",
  "required": ["query_id", "episode_id", "question_type", "is_abstention", "query_text", "gold_answer", "evaluator_id", "supporting_evidence_ids", "split"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "question_type": {"type": "string", "minLength": 1},
    "is_abstention": {"type": "boolean"},
    "query_text": {"type": "string"},
    "gold_answer": {"type": "string"},
    "evaluator_id": {"type": "string", "minLength": 1},
    "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "split": {"enum": ["development", "calibration", "acceptance"]}
  }
}

