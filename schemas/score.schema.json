{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Score with raw supporting-annotation mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score_id",
    "run_id",
    "query_id",
    "score",
    "evaluator_id",
    "judge_cache_key",
    "protected_label_access_log_id",
    "support_mappings"
  ],
  "properties": {
    "score_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "query_id": {"type": "string", "minLength": 1},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "evaluator_id": {"type": "string", "minLength": 1},
    "judge_cache_key": {"type": "string", "minLength": 1},
    "protected_label_access_log_id": {"type": "string", "minLength": 1},
    "support_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/SupportMappingRaw"}
    }
  },
  "$defs": {
    "idList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "SupportMappingRaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "support_mapping_status",
        "mapped_evidence_ids",
        "mapped_chunk_ids",
        "mapped_leaf_ids"
      ],
      "properties": {
        "annotation_id": {"type": "string", "minLength": 1},
        "support_mapping_status": {
          "enum": ["exact", "expanded_to_chunks", "unresolved"]
        },
        "mapped_evidence_ids": {"$ref": "#/$defs/idList"},
        "mapped_chunk_ids": {"$ref": "#/$defs/idList"},
        "mapped_leaf_ids": {"$ref": "#/$defs/idList"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"support_mapping_status": {"const": "unresolved"}}
          },
          "then": {"properties": {"mapped_leaf_ids": {"maxItems": 0}}}
        },
        {
          "if": {
            "properties": {
              "support_mapping_status": {
                "enum": ["exact", "expanded_to_chunks"]
              }
            }
          },
          "then": {"properties": {"mapped_leaf_ids": {"minItems": 1}}}
        }
      ]
    }
  }
}
