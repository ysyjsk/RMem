# Project data: deny by default. Only synthetic test fixtures are versioned.
/data/**
!/data/fixtures/
!/data/fixtures/**
!/data/protected_acceptance/
!/data/protected_acceptance/.gitkeep

# Runtime artifacts: keep generated probes, episodes, assignments, and rows local.
# Human-readable qualification reports are the only versioned artifact class.
/artifacts/**
!/artifacts/reports/
!/artifacts/reports/**/
!/artifacts/reports/*.md
!/artifacts/reports/**/*.md
!/artifacts/reports/**/.gitkeep

# Rebuildable caches remain local; retain only the directory placeholder.
/cache/**
!/cache/.gitkeep
